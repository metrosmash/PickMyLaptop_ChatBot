# Copy this file to `.env` and fill in your values.
# `.env` is gitignored; never commit real credentials.

# --- TLS (required by Aiven and most managed MySQL providers) ---
# The Aiven Project CA certificate is already committed at database/certs/ca.pem.
DB_ssl_ca=database/certs/ca.pem
DB_ssl_verify_cert=True

# --- Option A: single canonical connection string (recommended, provider agnostic) ---
# Copy the Service URI from: Aiven Console -> your MySQL service -> Overview.
# NOTE: Aiven uses a NON-STANDARD PORT (25911 in this example) -- not 3306!
DATABASE_URL=mysql://avnadmin:your_password@mysql-your-service.aivencloud.com:25911/metro_laptop

# --- Option B: individual settings (used when DATABASE_URL is not set) ---
# For a plain local MySQL without TLS, leave DB_ssl_ca empty.
DB_host=localhost
DB_port=3306
DB_name=metro_laptop
DB_username=your_db_username
DB_password=your_db_password
DB_timeout=30
DB_table=laptop_dataset
